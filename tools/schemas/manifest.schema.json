  "files":{"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["sha256","bytes"],
   "properties":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"bytes":{"type":"integer","minimum":1}}}},
